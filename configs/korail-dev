# port는 따로 nuxt.config.js에 설정해줘야한다. 자동화하면 배포 오류
port="8205"

# 와트매니저 백엔드
backendURL_local="http://localhost:8090/"
backendURL="https://koraildev.watttalk.kr/wattmanager-server/"

# 와트매니저2 백엔드
manager2serverURL=""

# 와트톡
powertlakState="loginCheck"
powertalkLogin_local="http://localhost:4500/login/login-check?jwt_token="
powertalkLogin="https://koraildev.watttalk.kr/watttalk/login/login-check?jwt_token="

# 와트 메모
powermemo="https://koraildev.watttalk.kr/sftp/watt"
powermemoSavefolder="/home/sftpuser01/watt"

# QR
qr="default"
elecQR="false"
elecFilePath="/home/watt/hdd_ext/Storage/watttalk/korail/QR/file"
elecFolderPath="/home/watt/hdd_ext/Storage/watttalk/korail/QR/folder"

# 자료 관리
# 일반 사용자 자료 관리 접근 권한 (true: 부여, false: 미부여)
att_access_user="true"
att_videoPlayPath="https://koraildev.watttalk.kr/Storage/powertalk/dev/Dashs/Src/"
att_filePath="https://koraildev.watttalk.kr/storage/watttalk/korail/filebox/"
detailFilePath="/home/watt/hdd_ext/Storage/watttalk/korail/filebox/"
fileUploadBackend="https://koraildev.watttalk.kr/wattmanager-server/"

# 프로필 사진
profilePhotoSavefolder="/home/watt/hdd_ext/Storage/watttalk/korail/profiles"
profilePhotoUrl="https://koraildev.watttalk.kr/Storage/watttalk/korail/profiles"

# 로고
useEnterprise="korail"

# 동영상 보안
use_bento4="false"

# 파일함
# 파일 업로드 백엔드 분기 (false: backendURL 사용, true: fileBoxBackend 사용)
separateBackendUploadPath="false"
fileBoxBackend="https://koraildev.watttalk.kr/wattmanager-server/"

# 비밀번호 보안 적용
checkPswPatern="false"
pwdRulesType=""

# 자동 로그아웃
forceLogout24="false"

# 비밀번호 오류 시 계정 로그인 차단
blockAcount="false"

# 본인 인증 (impId와 pg는 danal 계정 설정으로 "dlenc.watttalk"만 사용. 다른 곳들은 "" 공백값 지정해야한다)
impId=""
pg=""

# qr 값에 따라서 tab 변동

# QR tab, 전자QR 보이는 설정
# qr=default

# QR tab, 안전QR 보이는 설정
# qr=safety

# Qr tab, 파워QR 보이는 설정
# qr=power

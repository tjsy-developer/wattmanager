# port는 따로 nuxt.config.js에 설정해줘야한다. 자동화하면 배포 오류
port="8205"

# 와트매니저 백엔드
backendURL_local=""
backendURL="https://dlenc.watttalk.kr:8101/"

# 와트매니저2 백엔드
manager2serverURL="/wattmanager2-server/"

# 와트톡
powertlakState="loginCheck"
powertalkLogin_local=""
powertalkLogin="https://dlenc.watttalk.kr:8102/login/login-check?jwt_token="

# 와트 메모
powermemo="https://dlenc.watttalk.kr/sftp/dlenc"
powermemoSavefolder="/home/sftproot/dlenc/"

# QR
qr="default"
elecQR="true"
elecFilePath="/home/watt/hdd_ext/Storage/watttalk/dlenc/QR/file"
elecFolderPath="D:\\Storage\\powertalk\\dev\\QR\\folder"

# 자료 관리
# 일반 사용자 자료 관리 접근 권한 (true: 부여, false: 미부여)
att_access_user="true"
att_videoPlayPath="https://dlenc.watttalk.kr/Storage/powertalk/dev/Dashs/Src/"
att_filePath="https://dlenc.watttalk.kr/storage/watttalk/dlenc/filebox/"
detailFilePath="/home/watt/hdd_ext/Storage/watttalk/dlenc/filebox/"
fileUploadBackend="https://dlenc.watttalk.kr:8101/"

# 프로필 사진
profilePhotoSavefolder="/home/watt/dlenc/web/user-profile-images/"
profilePhotoUrl="https://dlenc.watttalk.kr/profiles/"

# 로고
useEnterprise="dlenc"

# 동영상 보안
use_bento4="false"

# 파일함
# 파일 업로드 백엔드 분기 (false: backendURL 사용, true: fileBoxBackend 사용)
separateBackendUploadPath="false"
fileBoxBackend="https://dlenc.watttalk.kr:8101/"

# 비밀번호 보안 적용
checkPswPatern="true"
pwdRulesType="1"


# 자동 로그아웃
forceLogout24="true"

# 비밀번호 오류 시 계정 로그인 차단
blockAcount="true"

# 본인 인증 (impId와 pg는 danal 계정 설정으로 "dlenc.watttalk"만 사용. 다른 곳들은 "" 공백값 지정해야한다)
impId="imp67320503"
pg="danal.B010008141"

# qr 값에 따라서 tab 변동

# QR tab, 전자QR 보이는 설정
# qr=default

# QR tab, 안전QR 보이는 설정
# qr=safety

# Qr tab, 파워QR 보이는 설정
# qr=power

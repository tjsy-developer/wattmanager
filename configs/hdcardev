# port는 따로 nuxt.config.js에 설정해줘야한다. 자동화하면 배포 오류
port=3000

# 와트매니저 백엔드
backendURL_local=""
backendURL=https://hdcardev.watttalk.kr:8205/wattmanager-server/

# 와트매니저2 백엔드
manager2serverURL=/wattmanager2-server/

# 와트톡
powertlakState="loginCheck"
powertalkLogin_local=""
powertalkLogin="https://hdcardev.watttalk.kr:8205/watttalk/login/login-check?jwt_token="

# 와트 메모
powermemo=https://hdcardev.watttalk.kr:8205/storage/watttalk/hdcar
powermemoSavefolder=/data/Storage/watttalk/hdcar/

# QR
qr=default
elecQR=false
elecFilePath=/data/Storage/watttalk/hdcar/QR/file
elecFolderPath=/data/Storage/watttalk/hdcar/QR/folder

# 자료 관리
# 일반 사용자 자료 관리 접근 권한 (true: 부여, false: 미부여)
att_access_user=true
att_videoPlayPath=https://hdcardev.watttalk.kr:8205/storage/watttalk/hdcar/Dashs/Src/
att_filePath=https://hdcardev.watttalk.kr:8205/storage/watttalk/hdcar/filebox/
detailFilePath=/data/Storage/watttalk/hdcar/filebox/
fileUploadBackend=https://hdcardev.watttalk.kr:8205/wattmanager-server

# 프로필 사진
profilePhotoSavefolder=/data/Storage/watttalk/hdcar/profile
profilePhotoUrl=https://hdcardev.watttalk.kr:8205/storage/watttalk/hdcar/profile/

# 로고
useEnterprise=hdcar

# 동영상 보안
use_bento4=false

# 파일함
# 파일 업로드 백엔드 분기 (false: backendURL 사용, true: fileBoxBackend 사용)
separateBackendUploadPath=false
fileBoxBackend=https://hdcardev.watttalk.kr:8205/wattmanager-server

# 비밀번호 보안 적용
checkPswPatern=false

# 자동 로그아웃
forceLogout24=false

# 본인 인증 (impId와 pg는 danal 계정 설정으로 "dlenc.watttalk"만 사용. 다른 곳들은 "" 공백값 지정해야한다)
impId=""
pg=""

# qr 값에 따라서 tab 변동

# QR tab, 전자QR 보이는 설정
# qr=default

# QR tab, 안전QR 보이는 설정
# qr=safety

# Qr tab, 파워QR 보이는 설정
# qr=power
